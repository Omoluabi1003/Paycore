# Secure account access (Auth0 Regular Web Application)
APP_BASE_URL=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
# Non-owner, non-superuser PostgreSQL runtime connection; use certificate-verified TLS.
DATABASE_URL=
# Google Web OAuth application with Gmail API enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Independent random 32-byte encryption key encoded as 64 hex characters
GMAIL_ENCRYPTION_KEY=
# Strong random scheduler bearer secret
CRON_SECRET=
# Microsoft Entra Web application for Microsoft 365 / Outlook (alternative to Google)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# organizations for an app supporting work/school tenants, or the app's tenant GUID/domain
MICROSOFT_TENANT_ID=organizations
# Emergency switch: false pauses scans before database/provider work; unset/true preserves scanning.
PAYCORE_MAILBOX_SYNC_ENABLED=true
